    --wp-muted: #69716c;
    --wp-line: #dfe3df;
    --wp-danger: #9d2f2f;
    color: var(--wp-ink);
    font-family: inherit;
  }

  #WeatherPanel-{{ section.id }} * { box-sizing: border-box; }
  #WeatherPanel-{{ section.id }} [hidden] { display: none !important; }
  #WeatherPanel-{{ section.id }} button,
  #WeatherPanel-{{ section.id }} input { font: inherit; }
  #WeatherPanel-{{ section.id }} button { cursor: pointer; }

