      "default": "Time for knitwear and insulated layers."
    },
    {
      "type": "text",
      "id": "wind_message",
      "label": "Wind message",
      "default": "Windproof layers made for blustery days."
    },
    {
      "type": "text",
      "id": "warm_message",
      "label": "Warm weather message",
      "default": "Keep it light with breathable outer layers."
    },
    {
      "type": "text",
      "id": "default_message",
      "label": "Default message",
      "default": "Layer up for changeable weather."
    }
  ],
  "presets": [
    {
      "name": "Weather panel"
    }
  ]
}
