  #WeatherPanel-{{ section.id }} .wp-forecast-card { padding: 20px; border: 1px solid var(--wp-line); background: #fff; }
  #WeatherPanel-{{ section.id }} .wp-forecast-card-top,
  #WeatherPanel-{{ section.id }} .wp-forecast-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  #WeatherPanel-{{ section.id }} .wp-forecast-day { margin: 0; font-weight: 850; }
  #WeatherPanel-{{ section.id }} .wp-forecast-icon { font-size: 1.45rem; }
  #WeatherPanel-{{ section.id }} .wp-forecast-condition { margin: 14px 0 18px; color: var(--wp-muted); }
  #WeatherPanel-{{ section.id }} .wp-forecast-temp { font-size: 1.35rem; font-weight: 850; }
  #WeatherPanel-{{ section.id }} .wp-forecast-temp span { color: var(--wp-muted); font-weight: 600; }
  #WeatherPanel-{{ section.id }} .wp-rain-chance { color: var(--wp-muted); font-size: .82rem; }
  #WeatherPanel-{{ section.id }} .wp-footer { padding: 18px 42px; border-top: 1px solid var(--wp-line); color: var(--wp-muted); font-size: .74rem; }

  @media (max-width: 820px) {
    #WeatherPanel-{{ section.id }} .wp-shell { width: min(100% - 20px, 680px); margin: 10px auto; border-radius: 20px; }
    #WeatherPanel-{{ section.id }} .wp-header { grid-template-columns: 1fr; gap: 28px; padding: 28px 22px; }
    #WeatherPanel-{{ section.id }} .wp-panel-content { padding: 24px 18px; }
    #WeatherPanel-{{ section.id }} .wp-current-grid { grid-template-columns: 1fr; }
    #WeatherPanel-{{ section.id }} .wp-current-card { flex-direction: column; padding: 22px; }
    #WeatherPanel-{{ section.id }} .wp-current-details { align-self: stretch; }
    #WeatherPanel-{{ section.id }} .wp-merch-card { min-height: 220px; padding: 24px; }
    #WeatherPanel-{{ section.id }} .wp-forecast-grid { grid-template-columns: 1fr; }
    #WeatherPanel-{{ section.id }} .wp-forecast-card { display: grid; grid-template-columns: 1fr auto; gap: 6px 18px; align-items: center; }
    #WeatherPanel-{{ section.id }} .wp-forecast-card-top { grid-column: 1 / -1; }
    #WeatherPanel-{{ section.id }} .wp-forecast-condition { margin: 6px 0 0; }
    #WeatherPanel-{{ section.id }} .wp-forecast-meta { justify-content: flex-end; }
    #WeatherPanel-{{ section.id }} .wp-footer { align-items: flex-start; flex-direction: column; padding: 16px 20px; }
  }

  @media (max-width: 480px) {
    #WeatherPanel-{{ section.id }} .wp-search-control { flex-direction: column; }
    #WeatherPanel-{{ section.id }} .wp-search-button { width: 100%; }
    #WeatherPanel-{{ section.id }} .wp-location-row { align-items: flex-start; flex-direction: column; gap: 6px; }
    #WeatherPanel-{{ section.id }} .wp-condition-heading { align-items: flex-start; }
    #WeatherPanel-{{ section.id }} .wp-weather-icon { width: 54px; height: 54px; flex-basis: 54px; font-size: 1.6rem; }
    #WeatherPanel-{{ section.id }} .wp-current-details { grid-template-columns: 1fr; }
  }
</style>

<script>
(() => {
  const SECTION_ID = 'WeatherPanel-{{ section.id }}';
  const GEO_URL = 'https://geocoding-api.open-meteo.com/v1/search';
  const FORECAST_URL = 'https://api.open-meteo.com/v1/forecast';

  const WEATHER_CODES = {
    0: ['Clear sky', '☀️'], 1: ['Mainly clear', '🌤️'], 2: ['Partly cloudy', '⛅'], 3: ['Overcast', '☁️'],
    45: ['Fog', '🌫️'], 48: ['Rime fog', '🌫️'], 51: ['Light drizzle', '🌦️'], 53: ['Moderate drizzle', '🌦️'],
    55: ['Dense drizzle', '🌧️'], 56: ['Light freezing drizzle', '🌧️'], 57: ['Dense freezing drizzle', '🌧️'],
    61: ['Light rain', '🌦️'], 63: ['Moderate rain', '🌧️'], 65: ['Heavy rain', '🌧️'], 66: ['Light freezing rain', '🌧️'],
    67: ['Heavy freezing rain', '🌧️'], 71: ['Light snow', '🌨️'], 73: ['Moderate snow', '🌨️'], 75: ['Heavy snow', '❄️'],
    77: ['Snow grains', '❄️'], 80: ['Light rain showers', '🌦️'], 81: ['Moderate rain showers', '🌧️'], 82: ['Heavy rain showers', '🌧️'],
    85: ['Light snow showers', '🌨️'], 86: ['Heavy snow showers', '❄️'], 95: ['Thunderstorm', '⛈️'],
    96: ['Thunderstorm with light hail', '⛈️'], 99: ['Thunderstorm with heavy hail', '⛈️']
  };

  function initWeatherPanel(root) {
    if (!root || root.dataset.weatherInitialised === 'true') return;
    root.dataset.weatherInitialised = 'true';

    const els = {
      searchInput: root.querySelector('.wp-search-input'),
      searchButton: root.querySelector('.wp-search-button'),
      searchResults: root.querySelector('.wp-search-results'),
      searchStatus: root.querySelector('.wp-search-status'),
      panelContent: root.querySelector('.wp-panel-content'),
      loadingState: root.querySelector('.wp-loading-state'),
      errorState: root.querySelector('.wp-error-state'),
      errorMessage: root.querySelector('.wp-error-message'),
      retryButton: root.querySelector('.wp-retry-button'),
      weatherContent: root.querySelector('.wp-weather-content'),
      locationName: root.querySelector('.wp-location-name'),
      updatedTime: root.querySelector('.wp-updated-time'),
      currentIcon: root.querySelector('.wp-weather-icon'),
      currentCondition: root.querySelector('.wp-condition-name'),
      currentTemp: root.querySelector('.wp-current-temp'),
      feelsLike: root.querySelector('.wp-feels-like'),
      windSpeed: root.querySelector('.wp-wind-speed'),
      merchMessage: root.querySelector('.wp-merch-message'),
      forecastGrid: root.querySelector('.wp-forecast-grid')
    };

    const messages = {
      rain: root.dataset.rainMessage,
      cold: root.dataset.coldMessage,
      wind: root.dataset.windMessage,
      warm: root.dataset.warmMessage,
      fallback: root.dataset.defaultMessage
    };

    let selectedLocation = null;
    let searchController = null;
    let forecastController = null;
    let defaultController = null;
    let debounceTimer = null;

    function weatherInfo(code, isDay = 1) {
      if (isDay === 0 && (code === 0 || code === 1)) {
        return [WEATHER_CODES[code][0], '🌙'];
      }
      return WEATHER_CODES[code] || ['Changeable', '🌥️'];
    }

    function escapeHtml(value = '') {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function formatLocation(location) {
      const region = location.admin1 && location.admin1 !== location.name ? location.admin1 : '';
      return [location.name, region].filter(Boolean).join(', ');
    }

    function uniqueLocations(results) {
      const seen = new Set();
      return results.filter((location) => {
        const key = `${location.name}|${location.admin1 || ''}|${location.latitude}|${location.longitude}`;
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function setPanelState(state, message = '') {
      els.panelContent.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
      els.loadingState.hidden = state !== 'loading';
      els.errorState.hidden = state !== 'error';
      els.weatherContent.hidden = state !== 'success';
      if (message) els.errorMessage.textContent = message;
    }

    function closeResults() {
      els.searchResults.hidden = true;
      els.searchResults.innerHTML = '';
      els.searchInput.setAttribute('aria-expanded', 'false');
    }

    function setSearchBusy(isBusy) {
      els.searchButton.disabled = isBusy;
      els.searchButton.textContent = isBusy ? 'Searching…' : 'Search';
    }

    async function fetchJsonWithTimeout(url, controller, timeoutMs) {
      let timedOut = false;
      const timeout = setTimeout(() => {
        timedOut = true;
        controller.abort();
      }, timeoutMs);

      try {
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
        return await response.json();
      } catch (error) {
        if (error.name === 'AbortError' && timedOut) {
          throw new Error('The request took too long. Please try again.');
        }
        throw error;
      } finally {
        clearTimeout(timeout);
      }
    }

    async function searchLocations(query) {
      const term = query.trim();

      if (defaultController) {
        defaultController.abort();
        defaultController = null;
      }

      if (searchController) {
        searchController.abort();
        searchController = null;
        setSearchBusy(false);
      }

      if (term.length < 2) {
        closeResults();
        els.searchStatus.textContent = term ? 'Type at least 2 characters.' : '';
        return;
      }

      const controller = new AbortController();
      searchController = controller;
      setSearchBusy(true);
      els.searchStatus.textContent = '';

      const params = new URLSearchParams({
        name: term,
        count: '5',
        countryCode: 'GB',
        language: 'en',
        format: 'json'
      });

      try {
        const data = await fetchJsonWithTimeout(`${GEO_URL}?${params}`, controller, 7000);
        if (controller !== searchController) return;
        const results = uniqueLocations(data.results || []);

        if (!results.length) {
          closeResults();
          els.searchStatus.textContent = 'No UK towns or cities found. Try another search.';
          return;
        }

        els.searchResults.innerHTML = results.map((location, index) => {
          const secondary = [location.admin1, location.country].filter(Boolean).join(' · ');
          return `<button class="wp-result-button" type="button" role="option" data-index="${index}">
            <strong>${escapeHtml(location.name)}</strong><span>${escapeHtml(secondary)}</span>
          </button>`;
        }).join('');

        els.searchResults.hidden = false;
        els.searchInput.setAttribute('aria-expanded', 'true');
        els.searchResults.querySelectorAll('.wp-result-button').forEach((button) => {
          button.addEventListener('click', () => chooseLocation(results[Number(button.dataset.index)]));
        });
      } catch (error) {
        if (error.name === 'AbortError') return;
        closeResults();
        els.searchStatus.textContent = error.message.includes('too long')
          ? error.message
          : 'Location search failed. Please try again.';
      } finally {
        if (controller === searchController) {
          setSearchBusy(false);
          searchController = null;
        }
      }
    }

    async function chooseLocation(location) {
      if (defaultController) {
        defaultController.abort();
        defaultController = null;
      }

      selectedLocation = {
        name: location.name,
        admin1: location.admin1 || '',
        country: location.country || 'United Kingdom',
        latitude: location.latitude,
        longitude: location.longitude
      };
      els.searchInput.value = formatLocation(selectedLocation);
      els.searchStatus.textContent = '';
      closeResults();
      await loadForecast(selectedLocation);
    }

    async function loadForecast(location) {
      if (forecastController) forecastController.abort();
      const controller = new AbortController();
      forecastController = controller;
      setPanelState('loading');

      const params = new URLSearchParams({
        latitude: location.latitude,
        longitude: location.longitude,
        current: 'temperature_2m,apparent_temperature,weather_code,wind_speed_10m,precipitation,is_day',
        daily: 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max',
        timezone: 'Europe/London',
        forecast_days: '4'
      });

      try {
        const data = await fetchJsonWithTimeout(`${FORECAST_URL}?${params}`, controller, 9000);
        if (controller !== forecastController) return;
        validateForecast(data);
        renderWeather(data, location);
        setPanelState('success');
      } catch (error) {
        if (error.name === 'AbortError' || controller !== forecastController) return;
        setPanelState(
          'error',
          error.message.includes('too long')
            ? error.message
            : 'The weather service is unavailable right now. Please retry.'
        );
      } finally {
        if (controller === forecastController) forecastController = null;
      }
    }

    function validateForecast(data) {
      const current = data?.current;
      const daily = data?.daily;
      const requiredCurrentValues = [
        current?.temperature_2m,
        current?.apparent_temperature,
        current?.weather_code,
        current?.wind_speed_10m,
        current?.precipitation,
        current?.is_day
      ];
      const hasCurrent = typeof current?.time === 'string'
        && requiredCurrentValues.every(Number.isFinite);
      const hasFourDays = daily?.time?.length >= 4
        && daily?.weather_code?.length >= 4
        && daily?.temperature_2m_max?.length >= 4
        && daily?.temperature_2m_min?.length >= 4
        && daily?.precipitation_probability_max?.length >= 4
        && [0, 1, 2, 3].every((index) => (
          typeof daily.time[index] === 'string'
          && Number.isFinite(daily.weather_code[index])
          && Number.isFinite(daily.temperature_2m_max[index])
          && Number.isFinite(daily.temperature_2m_min[index])
          && Number.isFinite(daily.precipitation_probability_max[index])
        ));
      if (!hasCurrent || !hasFourDays) throw new Error('The weather service returned incomplete data.');
    }

    function merchandisingMessage(current, daily) {
      const rainyCodes = new Set([51,53,55,56,57,61,63,65,66,67,80,81,82,95,96,99]);
      const snowCodes = new Set([71,73,75,77,85,86]);
      const rainChanceToday = Number(daily.precipitation_probability_max?.[0] || 0);

      if (rainyCodes.has(current.weather_code) || current.precipitation > 0 || rainChanceToday >= 60) return messages.rain;
      if (snowCodes.has(current.weather_code) || current.apparent_temperature <= 7) return messages.cold;
      if (current.wind_speed_10m >= 30) return messages.wind;
      if (current.temperature_2m >= 18) return messages.warm;
      return messages.fallback;
    }

    function renderWeather(data, location) {
      const current = data.current;
      const [condition, icon] = weatherInfo(current.weather_code, current.is_day);
      els.locationName.textContent = formatLocation(location);
      els.updatedTime.textContent = `Updated ${formatUpdatedTime(current.time)}`;
      els.currentIcon.textContent = icon;
      els.currentCondition.textContent = condition;
      els.currentTemp.textContent = Math.round(current.temperature_2m);
      els.feelsLike.textContent = Math.round(current.apparent_temperature);
      els.windSpeed.textContent = Math.round(current.wind_speed_10m);
      els.merchMessage.textContent = merchandisingMessage(current, data.daily);
      renderForecast(data.daily);
    }

    function renderForecast(daily) {
      els.forecastGrid.innerHTML = [1, 2, 3].map((index) => {
        const [condition, icon] = weatherInfo(daily.weather_code[index]);
        const high = Math.round(daily.temperature_2m_max[index]);
        const low = Math.round(daily.temperature_2m_min[index]);
        const rain = Math.round(daily.precipitation_probability_max[index] || 0);
        return `<article class="wp-forecast-card">
          <div class="wp-forecast-card-top"><p class="wp-forecast-day">${formatDay(daily.time[index])}</p><span class="wp-forecast-icon" aria-hidden="true">${icon}</span></div>
          <p class="wp-forecast-condition">${escapeHtml(condition)}</p>
          <div class="wp-forecast-meta"><div class="wp-forecast-temp">${high}° <span>/ ${low}°</span></div><div class="wp-rain-chance">${rain}% rain</div></div>
        </article>`;
      }).join('');
    }

    function formatDay(dateString) {
      return new Intl.DateTimeFormat('en-GB', { weekday: 'long', timeZone: 'Europe/London' })
        .format(new Date(`${dateString}T12:00:00Z`));
    }

    function formatUpdatedTime(dateTimeString) {
      const time = String(dateTimeString).split('T')[1];
      return time ? time.slice(0, 5) : 'just now';
    }

    async function loadDefaultLocation() {
      const defaultLocation = (root.dataset.defaultLocation || 'Manchester').trim();
      els.searchInput.value = defaultLocation;
      setPanelState('loading');

      if (defaultController) defaultController.abort();
      const controller = new AbortController();
      defaultController = controller;
      const params = new URLSearchParams({
        name: defaultLocation,
        count: '1',
        countryCode: 'GB',
        language: 'en',
        format: 'json'
      });

      try {
        const data = await fetchJsonWithTimeout(`${GEO_URL}?${params}`, controller, 7000);
        const first = data.results?.[0];
        if (!first) throw new Error('The default UK location could not be found.');
        await chooseLocation(first);
      } catch (error) {
        if (error.name === 'AbortError') return;
        setPanelState(
          'error',
          error.message.includes('too long') ? error.message : 'The default location could not be loaded. Try searching for another UK town or city.'
        );
      } finally {
        if (controller === defaultController) defaultController = null;
      }
    }

    els.searchButton.addEventListener('click', () => {
      clearTimeout(debounceTimer);
      searchLocations(els.searchInput.value);
    });
    els.searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => searchLocations(els.searchInput.value), 450);
    });
    els.searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        clearTimeout(debounceTimer);
        searchLocations(els.searchInput.value);
      }
      if (event.key === 'Escape') closeResults();
    });
    els.retryButton.addEventListener('click', () => {
      if (selectedLocation) loadForecast(selectedLocation);
      else loadDefaultLocation();
    });
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target) || !event.target.closest('.wp-search-wrap')) closeResults();
    });

    loadDefaultLocation();
  }

  initWeatherPanel(document.getElementById(SECTION_ID));

  document.addEventListener('shopify:section:load', (event) => {
    const root = event.target.querySelector(`#${CSS.escape(SECTION_ID)}`) || (event.target.id === SECTION_ID ? event.target : null);
    initWeatherPanel(root);
  });
})();
</script>

