  #WeatherPanel-{{ section.id }} .wp-outlook-section { margin-top: 34px; }
  #WeatherPanel-{{ section.id }} .wp-section-heading { margin-bottom: 12px; }
  #WeatherPanel-{{ section.id }} .wp-section-heading .wp-label { margin-bottom: 0; }
