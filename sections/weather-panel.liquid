<section
  id="WeatherPanel-{{ section.id }}"
  class="weather-panel-section"
  data-default-location="{{ section.settings.default_location | escape }}"
  data-rain-message="{{ section.settings.rain_message | escape }}"
  data-cold-message="{{ section.settings.cold_message | escape }}"
  data-wind-message="{{ section.settings.wind_message | escape }}"
  data-warm-message="{{ section.settings.warm_message | escape }}"
  data-default-message="{{ section.settings.default_message | escape }}"
>
  <div class="wp-shell">
    <header class="wp-header">
      <div>
        <p class="wp-eyebrow">Weather edit</p>
        <h2>Dress for the forecast.</h2>
        <p class="wp-intro">Search a UK town or city for current conditions and the next three days.</p>
      </div>

      <div class="wp-search-wrap">
        <label for="WeatherSearch-{{ section.id }}">Location</label>
        <div class="wp-search-control">
          <input
            id="WeatherSearch-{{ section.id }}"
            class="wp-search-input"
            type="search"
            placeholder="Try Manchester"
            autocomplete="off"
            aria-autocomplete="list"
            aria-controls="WeatherResults-{{ section.id }}"
            aria-expanded="false"
          >
          <button class="wp-search-button" type="button">Search</button>
        </div>
        <div id="WeatherResults-{{ section.id }}" class="wp-search-results" role="listbox" hidden></div>
        <p class="wp-search-status" aria-live="polite"></p>
      </div>
    </header>

    <div class="wp-panel-content" aria-live="polite" aria-busy="true">
      <div class="wp-state wp-loading-state">
        <span class="wp-spinner" aria-hidden="true"></span>
        <div>
          <strong>Checking the forecast…</strong>
          <p>Open-Meteo can occasionally take a moment.</p>
        </div>
      </div>

      <div class="wp-state wp-error-state" hidden>
        <div>
          <strong>We couldn’t load the weather.</strong>
          <p class="wp-error-message">Please try again.</p>
        </div>
        <button class="wp-retry-button" type="button">Try again</button>
      </div>

      <div class="wp-weather-content" hidden>
        <div class="wp-location-row">
          <div>
            <p class="wp-label">Now in</p>
            <h3 class="wp-location-name"></h3>
          </div>
          <p class="wp-updated-time"></p>
        </div>

        <div class="wp-current-grid">
          <article class="wp-current-card">
            <div class="wp-condition-heading">
              <div class="wp-weather-icon" aria-hidden="true">☁️</div>
              <div>
                <p class="wp-condition-name">Cloudy</p>
                <div class="wp-temperature"><span class="wp-current-temp">--</span><span>°C</span></div>
              </div>
            </div>

            <dl class="wp-current-details">
              <div>
                <dt>Feels like</dt>
                <dd><span class="wp-feels-like">--</span>°C</dd>
              </div>
              <div>
                <dt>Wind</dt>
                <dd><span class="wp-wind-speed">--</span> km/h</dd>
              </div>
            </dl>
          </article>

          <aside class="wp-merch-card">
            <p class="wp-label">Weather pick</p>
            <p class="wp-merch-message"></p>
          </aside>
        </div>

        <div class="wp-outlook-section">
          <div class="wp-section-heading">
            <p class="wp-label">Next 3 days</p>
            <p class="wp-forecast-note">High / low · rain chance</p>
          </div>
          <div class="wp-forecast-grid"></div>
        </div>
      </div>
    </div>

    <footer class="wp-footer">
      <span>Weather data by Open-Meteo</span>
    </footer>
  </div>
</section>

<style>
