  #WeatherPanel-{{ section.id }} .wp-temperature span:last-child { margin-top: 7px; font-size: .28em; letter-spacing: 0; }

  #WeatherPanel-{{ section.id }} .wp-current-details {
    min-width: 180px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    align-self: flex-end;
    margin: 0;
  }
  #WeatherPanel-{{ section.id }} .wp-current-details div { padding-left: 14px; border-left: 1px solid var(--wp-line); }
  #WeatherPanel-{{ section.id }} .wp-current-details dt { color: var(--wp-muted); font-size: .77rem; }
  #WeatherPanel-{{ section.id }} .wp-current-details dd { margin: 5px 0 0; font-weight: 800; }

  #WeatherPanel-{{ section.id }} .wp-merch-card {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    background: var(--wp-forest-soft);
    color: #fff;
  }
  #WeatherPanel-{{ section.id }} .wp-merch-card .wp-label { color: var(--wp-accent); }
  #WeatherPanel-{{ section.id }} .wp-merch-message {
    margin: auto 0;
